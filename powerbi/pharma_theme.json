{
  "name": "Pharma Market - Cristian Costa",
  "dataColors": ["#13A89E", "#0B2545", "#8DA9C4", "#F2A541", "#E4572E", "#5C6F82", "#76B041", "#B07BAC"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#13A89E",
  "good": "#13A89E",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B2545" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5C6F82" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0B2545" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B2545" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6F8" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "dropShadow": [{ "show": true, "preset": "Custom", "color": { "solid": { "color": "#000000" } }, "transparency": 92, "shadowBlur": 6, "shadowDistance": 2, "position": "Outer", "angle": 90 }]
      }
    }
  }
}
